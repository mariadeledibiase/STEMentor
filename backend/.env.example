# Rinomina questo file in .env e inserisci la tua chiave API reale.
# NON caricare mai il file .env (con la chiave vera) su GitHub o altrove.

PORT=3001

# Chiave API GRATUITA di Google Gemini.
# Come ottenerla (gratis, nessuna carta di credito):
# 1. Vai su https://aistudio.google.com/apikey
# 2. Accedi con un account Google
# 3. Clicca "Create API key"
# 4. Copia la chiave e incollala qui sotto
AI_API_KEY=inserisci_qui_la_tua_chiave_gemini

# Percorso del file del database SQLite
DB_PATH=./db/stementor.sqlite

# Sintesi vocale delle mentor: Azure AI Speech (voci neurali italiane).
# Come ottenere la chiave: portale Azure -> crea una risorsa "Speech" ->
# "Keys and Endpoint" -> copia una delle due chiavi e la regione.
# Senza queste due variabili la chat funziona ma le mentor restano mute.
AZURE_SPEECH_KEY=inserisci_qui_la_tua_chiave_azure_speech
AZURE_SPEECH_REGION=westeurope
